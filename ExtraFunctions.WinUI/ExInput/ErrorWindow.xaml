<?xml version="1.0" encoding="utf-8"?>
<ex:WindowEx
    x:Class="ExtraFunctions.WinUI.ExInput.ErrorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ex="using:WinUIEx"
    xmlns:local="using:ExtraFunctions.WinUI.ExInput"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" Width="600" MinHeight="300" MaxHeight="800" IsResizable="False">

    <Grid ColumnSpacing="10" RowSpacing="10" Padding="10" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" VerticalAlignment="Top" Height="30" Margin="-10"
              Background="{ThemeResource SmokeFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>

            <FontIcon Glyph="&#xEB90;" Margin="15,0" VerticalAlignment="Center" Foreground="Red"/>
            <TextBlock Grid.Column="1" Text="{x:Bind Title}" VerticalAlignment="Center" Margin="4"/>
        </Grid>

        <TextBlock x:Name="lblMSG" Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" Margin="10" FontSize="12"/>

        <Border Grid.Row="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Margin="-10"/>
        <Button Grid.Row="2" Click="Copy" HorizontalAlignment="Left" VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal">
                <SymbolIcon Symbol="Copy"/>
                <TextBlock Text="Copy" Margin="10,0,0,0"/>
            </StackPanel>
        </Button>
        <Button Grid.Row="2" Content="OK" Click="CloseClick" Width="200"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
    </Grid>
</ex:WindowEx>
