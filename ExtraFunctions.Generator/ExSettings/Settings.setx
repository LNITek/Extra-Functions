<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE Project [
   <!ELEMENT Project (Setting+)>
   <!ATTLIST Project
          Name CDATA #IMPLIED>
   <!ELEMENT Setting (#PCDATA)>
   <!ATTLIST Setting
          Name CDATA #REQUIRED
          Type CDATA #REQUIRED>
]>
<Project>
  <Setting Name="Setting" Type="object"/>
</Project>
